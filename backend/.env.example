PORT=4000
FRONTEND_URL=http://localhost:4200

# SQLite file path (relative to backend/)
DB_PATH=./data/arenasuite.db

# App-issued session JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Google Identity Services
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Only Google accounts on this email domain may sign in
ALLOWED_EMAIL_DOMAIN=thapar.edu

# Comma-separated emails that get auto-promoted to admin on Google login
# (first login or any later one). One-way bootstrap only — removing an
# email here later does not revoke admin rights already granted. Once you
# have your first admin, further role changes should go through the Admin
# Panel instead of this list.
ADMIN_EMAILS=
